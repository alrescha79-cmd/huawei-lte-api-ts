{
  "name": "huawei-lte-api",
  "version": "2.0.0",
  "description": "Modern TypeScript API for Huawei LAN/WAN LTE Modems with full feature parity to Python library",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "require": "./dist/index.js",
      "import": "./dist/index.mjs",
      "types": "./dist/index.d.ts"
    }
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "npm run build:cjs && npm run build:esm && npm run build:types",
    "build:cjs": "tsc --module commonjs --outDir dist/cjs",
    "build:esm": "tsc --module esnext --outDir dist/esm && echo '{\"type\":\"module\"}' > dist/esm/package.json",
    "build:types": "tsc --declaration --emitDeclarationOnly --outDir dist/types",
    "build:browser": "webpack",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "test:quick": "tsx test-quick.ts",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Salamek/huawei-lte-api-ts"
  },
  "keywords": [
    "huawei",
    "lte",
    "api",
    "modem",
    "router",
    "4g",
    "5g",
    "mobile",
    "broadband",
    "typescript",
    "nodejs"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "author": "Adam Schubert <adam.schubert@sg1-game.net>",
  "license": "LGPL-3.0",
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/xml2js": "^0.4.14",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "@vitest/ui": "^1.0.0",
    "eslint": "^8.50.0",
    "tsup": "^8.0.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0",
    "vitest": "^1.0.0"
  },
  "dependencies": {
    "xml2js": "^0.6.2"
  }
}
